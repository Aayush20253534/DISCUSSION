generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttributeKey {
  INTELLECT
  STRENGTH
  DISCIPLINE
  CREATIVITY
  VITALITY
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name") @db.VarChar(40)
  timezone     String    @default("UTC") @db.VarChar(80)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  character    Character?
  quests       Quest[]
  completions  QuestCompletion[]
  inventoryItems InventoryItem[]
  equipment      CharacterEquipment[]
  currencyTransactions CurrencyTransaction[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt, id], map: "sessions_user_created_id_idx")
  @@index([expiresAt])
  @@map("sessions")
}

model Character {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @unique @map("user_id") @db.Uuid
  avatarKey  String               @default("wanderer") @map("avatar_key") @db.VarChar(40)
  totalXp    Int                  @default(0) @map("total_xp")
  gold       Int                  @default(0)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributes CharacterAttribute[]

  @@map("characters")
}

model CharacterAttribute {
  id          String       @id @default(uuid()) @db.Uuid
  characterId String       @map("character_id") @db.Uuid
  key         AttributeKey
  xp          Int          @default(0)
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, key])
  @@map("character_attributes")
}


enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestRecurrence {
  ONCE
  DAILY
}

enum QuestStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model Quest {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  requestId        String          @map("request_id") @db.Uuid
  requestHash      String          @map("request_hash") @db.VarChar(64)
  title            String          @db.VarChar(120)
  description      String          @default("") @db.VarChar(2000)
  attribute        AttributeKey
  difficulty       QuestDifficulty @default(EASY)
  recurrence       QuestRecurrence @default(ONCE)
  status           QuestStatus     @default(ACTIVE)
  estimatedMinutes Int?            @map("estimated_minutes")
  dueDate          DateTime?        @map("due_date") @db.Date
  scheduleStartDate DateTime?       @map("schedule_start_date") @db.Date
  scheduleTimezone String?          @map("schedule_timezone") @db.VarChar(80)
  revision         Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  completions      QuestCompletion[]
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, status, createdAt, id])
  @@index([userId, status, dueDate, id])
  @@index([userId, status, recurrence, scheduleStartDate, id], map: "quests_user_status_recurrence_schedule_idx")
  @@index([userId, status, recurrence, dueDate, createdAt, id], map: "quests_user_status_recurrence_due_created_idx")
  @@index([userId, attribute, status])
  @@index([userId, status, completedAt, id])
  @@map("quests")
}

model QuestCompletion {
  id                   String          @id @default(uuid()) @db.Uuid
  originalQuestId      String          @map("original_quest_id") @db.Uuid
  questId              String?         @map("quest_id") @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  sourceRevision       Int             @map("source_revision")
  title                String          @db.VarChar(120)
  description          String          @db.VarChar(2000)
  attribute            AttributeKey
  difficulty           QuestDifficulty
  recurrence           QuestRecurrence @default(ONCE)
  dueDate              DateTime?       @map("due_date") @db.Date
  scheduledDate        DateTime?       @map("scheduled_date") @db.Date
  scheduleTimezone     String?         @map("schedule_timezone") @db.VarChar(80)
  estimatedMinutes     Int?            @map("estimated_minutes")
  xpAwarded            Int             @map("xp_awarded")
  goldAwarded          Int             @map("gold_awarded")
  attributeXpAwarded   Int             @map("attribute_xp_awarded")
  rulesVersion         Int             @map("rules_version")
  completedAt          DateTime        @map("completed_at") @db.Timestamptz(3)
  completedDate        DateTime        @map("completed_date") @db.Date
  timezone             String          @db.VarChar(80)
  levelBefore          Int             @map("level_before")
  levelAfter           Int             @map("level_after")
  attributeLevelBefore Int             @map("attribute_level_before")
  attributeLevelAfter  Int             @map("attribute_level_after")
  totalXpAfter         Int             @map("total_xp_after")
  goldAfter            Int             @map("gold_after")
  attributeXpAfter     Int             @map("attribute_xp_after")
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest                Quest?          @relation(fields: [questId], references: [id], onDelete: SetNull)
  currencyTransaction  CurrencyTransaction?

  @@unique([id, userId])
  @@index([userId, completedAt, id])
  @@index([questId])
  @@index([originalQuestId, scheduledDate])
  @@index([userId, originalQuestId, recurrence, scheduledDate], map: "quest_completions_user_occurrence_idx")
  @@index([userId, attribute, completedAt, id])
  @@index([userId, completedDate, completedAt, id], map: "quest_completions_user_activity_idx")
  @@map("quest_completions")
}


enum ShopItemType {
  AVATAR_FRAME
  PROFILE_BADGE
  CHARACTER_TITLE
  THEME
}

enum ItemRarity {
  COMMON
  RARE
  EPIC
}

enum EquipmentSlot {
  AVATAR_FRAME
  PROFILE_BADGE
  CHARACTER_TITLE
  THEME
}

enum CurrencyTransactionType {
  QUEST_REWARD
  SHOP_PURCHASE
}

model ShopItem {
  id             String          @id @default(uuid()) @db.Uuid
  sku            String          @unique @db.VarChar(64)
  name           String          @db.VarChar(80)
  description    String          @db.VarChar(400)
  type           ShopItemType
  rarity         ItemRarity      @default(COMMON)
  price          Int
  assetKey       String          @map("asset_key") @db.VarChar(64)
  sortOrder      Int             @default(0) @map("sort_order")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventoryItems InventoryItem[]

  @@index([active, type, sortOrder, id])
  @@map("shop_items")
}

model InventoryItem {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  shopItemId          String               @map("shop_item_id") @db.Uuid
  pricePaid           Int                  @map("price_paid")
  purchasedAt         DateTime             @default(now()) @map("purchased_at") @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem            ShopItem             @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  equipment           CharacterEquipment?
  currencyTransaction CurrencyTransaction?

  @@unique([userId, shopItemId])
  @@unique([id, userId])
  @@index([userId, purchasedAt, id])
  @@index([shopItemId])
  @@map("inventory_items")
}

model CharacterEquipment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  slot            EquipmentSlot
  inventoryItemId String        @unique @map("inventory_item_id") @db.Uuid
  equippedAt      DateTime      @default(now()) @map("equipped_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId, equippedAt])
  @@map("character_equipment")
}

model CurrencyTransaction {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  type              CurrencyTransactionType
  amount            Int
  balanceAfter      Int                     @map("balance_after")
  questCompletionId String?                 @unique @map("quest_completion_id") @db.Uuid
  inventoryItemId   String?                 @unique @map("inventory_item_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questCompletion   QuestCompletion?        @relation(fields: [questCompletionId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem?          @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@map("currency_transactions")
}
