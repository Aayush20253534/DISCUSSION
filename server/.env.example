# Copy to server/.env. Never put database credentials in client/.env.
NODE_ENV=development
PORT=4000
# Allowed browser origins. On Render this defaults to RENDER_EXTERNAL_URL when omitted.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Public API origin. Render fills this from RENDER_EXTERNAL_URL automatically.
# Set it explicitly on other hosts when the browser app is served from a different origin.
API_ORIGIN=http://localhost:4000
# Public canonical website origin used by prerendered metadata, robots.txt and sitemap.xml.
# On Render, RENDER_EXTERNAL_URL supplies this automatically when the value is omitted.
PUBLIC_APP_URL=http://localhost:5173
# Leave blank for the UI/API foundation preview without a database.
# Paste Neon's pooled connection string here, including sslmode=require.
DATABASE_URL=
# Paste the unpooled connection string here for migrations.
DIRECT_URL=
# Set to 1 only behind one trusted reverse proxy; otherwise leave at 0.
# Render defaults this to 1 automatically when RENDER=true.
TRUST_PROXY_HOPS=0
# Generated by npm run auth:configure. Keep private; required when DATABASE_URL is set.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7

# Email verification after signup. MAILJET_FROM_EMAIL must be a verified Mailjet sender.
EMAIL_OTP_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
PASSWORD_RESET_MINUTES=30
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=AtlasBorn

# Optional authenticated data cache. Leave both credentials blank to disable it.
# Upstash REST is used directly, so no Redis npm package is required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_CACHE_TTL_SECONDS=75
REDIS_CACHE_TIMEOUT_MS=300

# AI Quest Master. Set one or both keys. In auto mode Groq is tried first and Gemini is the fallback.
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
# Defaults are production-capable models with structured JSON output support.
GROQ_QUEST_MODEL=openai/gpt-oss-20b
GROQ_VERIFICATION_MODEL=qwen/qwen3.8-27b
GEMINI_QUEST_MODEL=gemini-2.5-flash-lite
GEMINI_VERIFICATION_MODEL=gemini-2.5-flash-lite
GEMINI_VERIFICATION_FALLBACK_MODEL=gemini-2.5-flash
GROQ_VERIFICATION_TIMEOUT_MS=12000
GEMINI_VERIFICATION_TIMEOUT_MS=30000
QUEST_VERIFICATION_TIMEOUT_MS=30000
AI_REQUEST_TIMEOUT_MS=12000
