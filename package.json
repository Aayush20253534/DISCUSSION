{
  "name": "life-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run db:generate && npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run db:generate && node scripts/run-tests.mjs",
    "verify": "npm run lint && npm run quality:audit && npm test && npm run db:validate && npm run build && npm run test:production",
    "render:build": "npm ci --workspaces --include-workspace-root --include=dev --no-audit --no-fund && npm run build && npm run db:deploy",
    "verify:live": "node scripts/live-smoke.mjs",
    "submission:check": "node scripts/submission-check.mjs",
    "db:generate": "npm run db:generate -w server",
    "db:validate": "npm run db:validate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:studio": "npm run db:studio -w server",
    "setup": "node scripts/setup.js && npm run db:generate",
    "auth:configure": "node scripts/configure-auth.js",
    "test:production": "npm run test:production -w server",
    "quality:audit": "node scripts/quality-audit.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
