# Copy to server/.env. Never put database credentials in client/.env.
NODE_ENV=development
PORT=4000
# Allowed browser origins. On Render this defaults to RENDER_EXTERNAL_URL when omitted.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Public canonical website origin used by prerendered metadata, robots.txt and sitemap.xml.
# On Render, RENDER_EXTERNAL_URL supplies this automatically when the value is omitted.
PUBLIC_APP_URL=http://localhost:5173
# Leave blank for the UI/API foundation preview without a database.
# Paste Neon's pooled connection string here, including sslmode=require.
DATABASE_URL=
# Paste the unpooled connection string here for migrations.
DIRECT_URL=
# Set to 1 only behind one trusted reverse proxy; otherwise leave at 0.
# Render defaults this to 1 automatically when RENDER=true.
TRUST_PROXY_HOPS=0
# Generated by npm run auth:configure. Keep private; required when DATABASE_URL is set.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7
